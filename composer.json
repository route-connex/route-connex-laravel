{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "route-connex/route-connex-laravel",
    "description": "Laravel plugin for route-connex",
    "keywords": [
        "laravel",
        "route-connex",
        "route-connex-laravel"
    ],
    "homepage": "https://github.com/route-connex/route-connex-laravel",
    "license": "MIT",
    "authors": [
        {
            "name": "Leo Oberle",
            "email": "leo@adroitcreations.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0||^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.9",
        "laravel/pao": "^1.0",
        "laravel/pint": "^1.29",
        "mongodb/laravel-mongodb": "^5.12",
        "orchestra/testbench": "^10.0||^11.0",
        "pestphp/pest": "^4.6||^5.0",
        "pestphp/pest-plugin-laravel": "^4.1||^5.0",
        "pestphp/pest-plugin-type-coverage": "^4.0||^5.0",
        "phpstan/extension-installer": "^1.4"
    },
    "suggest": {
        "mongodb/laravel-mongodb": "Required to use the package with a MongoDB connection (^5.12)."
    },
    "autoload": {
        "psr-4": {
            "RouteConnex\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RouteConnex\\Laravel\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "prepare": [
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "build": [
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --host=0.0.0.0 --port=8000 --ansi"
        ],
        "lint": [
            "vendor/bin/pint --parallel"
        ],
        "lint:check": [
            "vendor/bin/pint --parallel --test"
        ],
        "analyse": [
            "vendor/bin/phpstan analyse"
        ],
        "test:types": [
            "vendor/bin/pest --type-coverage --min=100"
        ],
        "test:unit": [
            "vendor/bin/pest --parallel"
        ],
        "test": [
            "@analyse",
            "@lint:check",
            "@test:types",
            "@test:unit"
        ],
        "clear": [
            "@php vendor/bin/testbench package:purge-skeleton --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "RouteConnex\\Laravel\\RouteConnexServiceProvider"
            ],
            "aliases": {
                "RouteConnex": "RouteConnex\\Laravel\\Facades\\RouteConnex"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
